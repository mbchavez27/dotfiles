# macOS Finder metadata (not needed in repo)
.DS_Store

# Exclude Claude session histories, logs, and authentication tokens
.claude/sessions/

# Claude-managed skill sync cache (machine-local)
claude/.claude/skills/synced/
.claude/settings.local.json
.claude/plugins/

# Exclude local Antigravity runtimes and active agent states
.gemini/antigravity-cli/logs/
.gemini/antigravity-cli/.state/

# Exclude local OpenCode secrets
opencode/service.json

